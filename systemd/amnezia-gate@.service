[Unit]
Description=Containerized AmneziaWG proxy profile %I
Documentation=man:systemd-nspawn(1)
Requires=amnezia-gate-network.service
After=amnezia-gate-network.service network-online.target modprobe@tun.service
Wants=network-online.target modprobe@tun.service
StartLimitIntervalSec=2min
StartLimitBurst=5

[Service]
Type=simple
SELinuxContext=system_u:system_r:container_runtime_t:s0
ExecStartPre=/usr/libexec/amnezia-gate-run prepare %I
ExecStart=/usr/libexec/amnezia-gate-run run %I
ExecStopPost=/usr/libexec/amnezia-gate-run cleanup %I
Restart=on-failure
RestartSec=10s
TimeoutStartSec=2min
TimeoutStopSec=20s
KillMode=mixed
Slice=machine.slice
Delegate=yes
TasksMax=512
DevicePolicy=closed
DeviceAllow=/dev/net/tun rwm
DeviceAllow=char-pts rw
DeviceAllow=/dev/loop-control rw
DeviceAllow=block-loop rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
