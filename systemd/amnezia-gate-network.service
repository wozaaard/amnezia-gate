[Unit]
Description=Networking prerequisite for Amnezia proxy profiles
Documentation=man:nft(8) man:systemd-nspawn(1)
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=amnezia-gate
RuntimeDirectoryMode=0755
ExecStart=/usr/libexec/amnezia-gate-network up
ExecStop=/usr/libexec/amnezia-gate-network down
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
