#!/usr/bin/gjs -m

import Adw from 'gi://Adw?version=1';
import Gio from 'gi://Gio';
import GLib from 'gi://GLib';
import GObject from 'gi://GObject';
import Gtk from 'gi://Gtk?version=4.0';
import Pango from 'gi://Pango';

const BUS_NAME = 'org.amnezia.Gate1';
const OBJECT_PATH = '/org/amnezia/Gate1';
const INTERFACE = 'org.amnezia.Gate1.Manager';
const PROFILE_PATTERN = /^[A-Za-z0-9][A-Za-z0-9-]{0,31}$/;
const STATISTICS_INTERVAL_SECONDS = 2;

const GateApplication = GObject.registerClass(
class GateApplication extends Adw.Application {
    constructor() {
        super({
            application_id: 'org.amnezia.Gate',
            flags: Gio.ApplicationFlags.DEFAULT_FLAGS,
        });
        this._window = null;
        this._proxy = null;
        this._profiles = new Map();
        this._rows = new Map();
        this._pending = new Map();
        this._statistics = new Map();
        this._statisticsPending = false;
        this._statisticsSource = 0;
        this._dnsBackend = '';
        this._dnsButton = null;
        this._dnsButtonLabel = null;
        this._dnsMenu = null;
        this._dnsPopover = null;
        this._dnsProfile = '';
        this._dnsState = 'off';
        this._dnsPending = false;
    }

    vfunc_activate() {
        if (this._window !== null) {
            this._window.present();
            return;
        }

        this._buildWindow();
        this._window.present();
        try {
            this._proxy = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SYSTEM,
                Gio.DBusProxyFlags.NONE,
                null,
                BUS_NAME,
                OBJECT_PATH,
                INTERFACE,
                null);
            this._proxy.connect('g-signal', (_proxy, _sender, signal) => {
                if (signal === 'Changed')
                    this._refresh();
            });
            this._refresh();
            this._startStatistics();
        } catch (error) {
            this._showError(error);
            this._showStatus('dialog-error-symbolic', 'Сервис недоступен',
                'Не удалось подключиться к системному D-Bus service.');
        }
    }

    vfunc_shutdown() {
        if (this._statisticsSource !== 0) {
            GLib.Source.remove(this._statisticsSource);
            this._statisticsSource = 0;
        }
        super.vfunc_shutdown();
    }

    _buildWindow() {
        this._window = new Adw.ApplicationWindow({
            application: this,
            title: 'Amnezia Gate',
            default_width: 680,
            default_height: 520,
        });

        const header = new Adw.HeaderBar({
            title_widget: new Adw.WindowTitle({
                title: 'Amnezia Gate',
                subtitle: 'Изолированные proxy-профили',
            }),
        });
        const refresh = new Gtk.Button({
            icon_name: 'view-refresh-symbolic',
            tooltip_text: 'Обновить',
        });
        refresh.add_css_class('flat');
        refresh.connect('clicked', () => this._refresh());
        header.pack_start(refresh);

        const importButton = new Gtk.Button({label: 'Импорт'});
        importButton.add_css_class('suggested-action');
        importButton.connect('clicked', () => this._chooseConfig());

        this._dnsButtonLabel = new Gtk.Label({label: 'DNS: выкл.'});
        const dnsButtonContent = new Gtk.Box({
            orientation: Gtk.Orientation.HORIZONTAL,
            spacing: 6,
        });
        dnsButtonContent.append(new Gtk.Image({icon_name: 'network-server-symbolic'}));
        dnsButtonContent.append(this._dnsButtonLabel);
        this._dnsMenu = new Gtk.Box({
            orientation: Gtk.Orientation.VERTICAL,
            spacing: 2,
            margin_top: 6,
            margin_bottom: 6,
            margin_start: 6,
            margin_end: 6,
        });
        this._dnsPopover = new Gtk.Popover({child: this._dnsMenu});
        this._dnsButton = new Gtk.MenuButton({visible: false});
        this._dnsButton.set_child(dnsButtonContent);
        this._dnsButton.set_popover(this._dnsPopover);
        this._dnsButton.add_css_class('flat');

        const actionButtons = new Gtk.Box({
            orientation: Gtk.Orientation.HORIZONTAL,
            spacing: 6,
        });
        actionButtons.append(this._dnsButton);
        actionButtons.append(importButton);
        const actionRow = new Gtk.Box({
            orientation: Gtk.Orientation.HORIZONTAL,
            margin_top: 6,
            margin_bottom: 6,
            margin_start: 18,
            margin_end: 18,
        });
        actionRow.append(new Gtk.Box({hexpand: true}));
        actionRow.append(actionButtons);
        const actionClamp = new Adw.Clamp({
            maximum_size: 720,
            tightening_threshold: 520,
            child: actionRow,
        });

        this._list = new Gtk.ListBox({
            selection_mode: Gtk.SelectionMode.NONE,
            margin_top: 24,
            margin_bottom: 24,
            margin_start: 18,
            margin_end: 18,
        });
        this._list.add_css_class('boxed-list');

        this._clamp = new Adw.Clamp({maximum_size: 720, tightening_threshold: 520});
        this._clamp.set_child(this._list);
        const scrolled = new Gtk.ScrolledWindow({
            hscrollbar_policy: Gtk.PolicyType.NEVER,
            vexpand: true,
            child: this._clamp,
        });

        this._toolbar = new Adw.ToolbarView();
        this._toolbar.add_top_bar(header);
        this._toolbar.add_top_bar(actionClamp);
        this._toolbar.set_content(scrolled);

        this._toasts = new Adw.ToastOverlay({child: this._toolbar});
        this._window.set_content(this._toasts);
    }

    _call(method, parameters, onSuccess = null, onError = null, showError = true) {
        if (this._proxy === null)
            return;
        this._proxy.call(
            method,
            parameters,
            Gio.DBusCallFlags.NONE,
            -1,
            null,
            (proxy, result) => {
                try {
                    const reply = proxy.call_finish(result).recursiveUnpack();
                    onSuccess?.(reply);
                } catch (error) {
                    if (showError)
                        this._showError(error);
                    onError?.();
                }
            });
    }

    _startStatistics() {
        this._refreshStatistics();
        this._statisticsSource = GLib.timeout_add_seconds(
            GLib.PRIORITY_DEFAULT,
            STATISTICS_INTERVAL_SECONDS,
            () => {
                this._refreshStatistics();
                return GLib.SOURCE_CONTINUE;
            });
    }

    _refreshStatistics() {
        if (this._statisticsPending)
            return;
        this._statisticsPending = true;
        this._call(
            'GetStatistics',
            null,
            ([statistics]) => {
                this._statisticsPending = false;
                this._acceptStatistics(statistics);
            },
            () => {
                this._statisticsPending = false;
            },
            false);
    }

    _acceptStatistics(statistics) {
        const receivedAt = GLib.get_monotonic_time();
        const next = new Map();
        for (const [name, receivedValue, sentValue, handshakeValue] of statistics) {
            const received = Number(receivedValue);
            const sent = Number(sentValue);
            const handshake = Number(handshakeValue);
            const previous = this._statistics.get(name);
            let receivedRate = null;
            let sentRate = null;
            if (previous !== undefined &&
                received >= previous.received && sent >= previous.sent) {
                const elapsed = (receivedAt - previous.receivedAt) / 1_000_000;
                if (elapsed > 0) {
                    receivedRate = (received - previous.received) / elapsed;
                    sentRate = (sent - previous.sent) / elapsed;
                }
            }
            next.set(name, {
                received,
                sent,
                handshake,
                receivedRate,
                sentRate,
                receivedAt,
            });
        }
        this._statistics = next;
        this._updateStatisticsRows();
    }

    _updateStatisticsRows() {
        for (const [name, {statisticsGrid}] of this._rows) {
            if (statisticsGrid !== null)
                this._updateStatisticsGrid(statisticsGrid, this._statistics.get(name));
        }
    }

    _profileGrid(name, socks, http, state) {
        const grid = new Gtk.Grid({
            column_spacing: 8,
            hexpand: true,
            halign: Gtk.Align.START,
            valign: Gtk.Align.CENTER,
        });
        for (const [column, title, value, width, xalign, tooltip] of [
            [0, 'ПРОФИЛЬ', name, 18, 0, name],
            [1, 'SOCKS', String(socks), 7, 0, `SOCKS port ${socks}`],
            [2, 'HTTP', String(http), 7, 0, `HTTP port ${http}`],
            [3, 'СОСТОЯНИЕ', state, 14, 0, state],
        ]) {
            const heading = this._fixedLabel(title, width, xalign, 'caption');
            heading.add_css_class('dim-label');
            const field = this._fixedLabel(value, width, xalign, 'monospace');
            field.set_tooltip_text(tooltip);
            grid.attach(heading, column, 0, 1, 1);
            grid.attach(field, column, 1, 1, 1);
        }
        return grid;
    }

    _statisticsGrid() {
        const grid = new Gtk.Grid({
            column_homogeneous: true,
            column_spacing: 8,
            valign: Gtk.Align.CENTER,
        });
        const widgets = {};
        for (const [column, key, title, tooltip] of [
            [0, 'received', 'RX', 'Получено через туннель'],
            [1, 'sent', 'TX', 'Отправлено через туннель'],
            [2, 'handshake', 'HANDSHAKE', 'Последний handshake'],
        ]) {
            const heading = this._statisticsLabel(title, 'caption');
            heading.add_css_class('dim-label');
            heading.set_tooltip_text(tooltip);
            const value = this._statisticsLabel('—', 'monospace');
            const detail = this._statisticsLabel(
                key === 'handshake' ? '' : '—/с', 'caption');
            detail.add_css_class('dim-label');
            detail.add_css_class('monospace');
            grid.attach(heading, column, 0, 1, 1);
            grid.attach(value, column, 1, 1, 1);
            grid.attach(detail, column, 2, 1, 1);
            widgets[`${key}Value`] = value;
            widgets[`${key}Detail`] = detail;
        }
        widgets.grid = grid;
        return widgets;
    }

    _fixedLabel(label, width, xalign, cssClass) {
        const widget = new Gtk.Label({
            label,
            width_chars: width,
            max_width_chars: width,
            xalign,
            ellipsize: Pango.EllipsizeMode.END,
        });
        widget.add_css_class(cssClass);
        return widget;
    }

    _statisticsLabel(label, cssClass) {
        return this._fixedLabel(label, 12, 0, cssClass);
    }

    _updateStatisticsGrid(widgets, statistics) {
        widgets.receivedValue.set_label(statistics === undefined
            ? '—'
            : GLib.format_size(Math.max(0, Math.round(statistics.received))));
        widgets.receivedDetail.set_label(this._formatRate(statistics?.receivedRate));
        widgets.sentValue.set_label(statistics === undefined
            ? '—'
            : GLib.format_size(Math.max(0, Math.round(statistics.sent))));
        widgets.sentDetail.set_label(this._formatRate(statistics?.sentRate));
        const [handshake, detail] = this._formatHandshake(statistics?.handshake ?? 0);
        widgets.handshakeValue.set_label(handshake);
        widgets.handshakeDetail.set_label(detail);
    }

    _formatRate(rate) {
        if (rate === undefined || rate === null)
            return '—/с';
        return `${GLib.format_size(Math.max(0, Math.round(rate)))}/с`;
    }

    _formatHandshake(timestamp) {
        if (timestamp <= 0)
            return ['—', ''];
        const seconds = Math.max(0, Math.floor(Date.now() / 1000 - timestamp));
        if (seconds < 60)
            return [`${seconds} с`, 'назад'];
        if (seconds < 3600)
            return [`${Math.floor(seconds / 60)} мин`, 'назад'];
        if (seconds < 86400)
            return [`${Math.floor(seconds / 3600)} ч`, 'назад'];
        return [`${Math.floor(seconds / 86400)} д`, 'назад'];
    }

    _refresh() {
        this._call(
            'GetDnsBackend',
            null,
            ([backend]) => {
                this._dnsBackend = backend;
                if (backend !== '') {
                    this._refreshDns();
                    return;
                }
                this._dnsProfile = '';
                this._dnsState = 'off';
                this._updateDnsControl();
                this._refreshProfiles();
            },
            () => {
                this._dnsBackend = '';
                this._dnsProfile = '';
                this._dnsState = 'unavailable';
                this._updateDnsControl();
                this._refreshProfiles();
            },
            false);
    }

    _refreshDns() {
        this._call(
            'GetDnsProfile',
            null,
            ([profile, state]) => {
                this._dnsProfile = profile;
                this._dnsState = state;
                this._updateDnsControl();
                this._refreshProfiles();
            },
            () => {
                this._dnsProfile = '';
                this._dnsState = 'unavailable';
                this._updateDnsControl();
                this._refreshProfiles();
            },
            false);
    }

    _updateDnsControl() {
        if (this._dnsButton === null)
            return;
        const available = this._dnsBackend !== '';
        this._dnsButton.set_visible(available);
        if (!available)
            return;

        let label = 'DNS: выкл.';
        if (this._dnsProfile !== '')
            label = `DNS: ${this._dnsProfile}`;
        else if (this._dnsState === 'unavailable')
            label = 'DNS: ошибка';
        this._dnsButtonLabel.set_label(label);
        this._dnsButton.set_sensitive(!this._dnsPending);
        this._dnsButton.remove_css_class('suggested-action');
        this._dnsButton.remove_css_class('destructive-action');
        if (this._dnsState === 'active')
            this._dnsButton.add_css_class('suggested-action');
        else if (this._dnsState === 'unavailable')
            this._dnsButton.add_css_class('destructive-action');

        const tooltip = {
            active: `Системный DNS через профиль ${this._dnsProfile}`,
            waiting: `Профиль ${this._dnsProfile} выбран; ожидается его запуск`,
            unavailable: 'DNS backend или resolver выбранного профиля недоступен',
            off: 'Системный DNS через Amnezia Gate отключён',
        }[this._dnsState] ?? 'Системный DNS через Amnezia Gate';
        this._dnsButton.set_tooltip_text(tooltip);

        for (let child = this._dnsMenu.get_first_child(); child !== null;
            child = this._dnsMenu.get_first_child())
            this._dnsMenu.remove(child);

        const choices = [['', 'Отключить']];
        for (const name of [...this._profiles.keys()].sort())
            choices.push([name, name]);
        for (const [name, choiceLabel] of choices) {
            const content = new Gtk.Box({
                orientation: Gtk.Orientation.HORIZONTAL,
                spacing: 12,
            });
            content.append(new Gtk.Label({
                label: choiceLabel,
                xalign: 0,
                hexpand: true,
            }));
            const selected = name === ''
                ? this._dnsProfile === '' && this._dnsState === 'off'
                : this._dnsProfile === name;
            if (selected)
                content.append(new Gtk.Image({icon_name: 'object-select-symbolic'}));
            const choice = new Gtk.Button({child: content});
            choice.add_css_class('flat');
            choice.connect('clicked', () => {
                this._dnsPopover.popdown();
                if (this._dnsProfile !== name)
                    this._setDnsProfile(name);
            });
            this._dnsMenu.append(choice);
        }
    }

    _refreshProfiles() {
        this._call(
            'ListProfiles',
            null,
            ([profiles]) => this._render(profiles),
            () => this._renderCurrent());
    }

    _renderCurrent() {
        this._render([...this._profiles.values()]);
    }

    _render(profiles) {
        for (let child = this._list.get_first_child(); child !== null;
            child = this._list.get_first_child())
            this._list.remove(child);

        this._profiles = new Map(profiles.map(profile => [profile[0], profile]));
        this._updateDnsControl();
        this._rows = new Map();
        if (profiles.length === 0) {
            this._showStatus('network-vpn-symbolic', 'Профилей пока нет',
                'Импортируйте AmneziaWG-конфигурацию и задайте имя профиля.');
            return;
        }

        this._clamp.set_child(this._list);
        for (const [name, socks, http, active, sub] of profiles) {
            const isActive = active === 'active';
            const pending = this._pending.get(name);
            const profile = [name, socks, http, active, sub];
            const row = new Gtk.ListBoxRow({
                activatable: false,
                selectable: false,
            });
            const content = new Gtk.Box({
                orientation: Gtk.Orientation.VERTICAL,
                spacing: 8,
                margin_top: 10,
                margin_bottom: 10,
                margin_start: 12,
                margin_end: 12,
            });
            const header = new Gtk.Box({
                orientation: Gtk.Orientation.HORIZONTAL,
                spacing: 8,
            });
            header.append(this._profileGrid(
                name, socks, http, pending ?? `${active}/${sub}`));
            const actions = new Gtk.Box({
                orientation: Gtk.Orientation.HORIZONTAL,
                spacing: 4,
                hexpand: true,
                halign: Gtk.Align.END,
                valign: Gtk.Align.CENTER,
            });
            let statisticsGrid = null;
            if (isActive) {
                statisticsGrid = this._statisticsGrid();
                this._updateStatisticsGrid(statisticsGrid, this._statistics.get(name));
            }
            this._rows.set(name, {row, profile, statisticsGrid});

            if (pending !== undefined) {
                actions.append(new Gtk.Spinner({
                    spinning: true,
                    valign: Gtk.Align.CENTER,
                    tooltip_text: pending,
                }));
            } else if (isActive) {
                const restart = this._actionButton(
                    'view-refresh-symbolic',
                    'Перезапустить',
                    () => this._control('RestartProfile', name));
                actions.append(restart);
            }
            if (pending === undefined) {
                const toggle = this._actionButton(
                    isActive ? 'media-playback-stop-symbolic' : 'media-playback-start-symbolic',
                    isActive ? 'Остановить' : 'Запустить',
                    () => this._control(isActive ? 'StopProfile' : 'StartProfile', name));
                actions.append(toggle);

                const remove = this._actionButton(
                    'edit-delete-symbolic',
                    'Удалить',
                    () => this._confirmRemove(name));
                remove.add_css_class('destructive-action');
                actions.append(remove);
            }
            header.append(actions);
            content.append(header);
            if (statisticsGrid !== null) {
                statisticsGrid.grid.set_halign(Gtk.Align.START);
                content.append(statisticsGrid.grid);
            }
            row.set_child(content);
            this._list.append(row);
        }
    }

    _showStatus(icon, title, description) {
        const page = new Adw.StatusPage({icon_name: icon, title, description});
        this._clamp.set_child(page);
    }

    _actionButton(icon, tooltip, callback) {
        const button = new Gtk.Button({
            icon_name: icon,
            tooltip_text: tooltip,
            valign: Gtk.Align.CENTER,
        });
        button.add_css_class('flat');
        button.connect('clicked', callback);
        return button;
    }

    _control(method, name) {
        if (this._pending.has(name))
            return;
        const labels = {
            StartProfile: 'Запуск…',
            StopProfile: 'Остановка…',
            RestartProfile: 'Перезапуск…',
            RemoveProfile: 'Удаление…',
        };
        this._pending.set(name, labels[method]);
        this._renderCurrent();
        this._call(
            method,
            new GLib.Variant('(s)', [name]),
            () => {
                this._pending.delete(name);
                if (method === 'RemoveProfile')
                    this._showToast(`${name} удалён`);
                this._refresh();
            },
            () => {
                this._pending.delete(name);
                this._renderCurrent();
            });
    }

    _setDnsProfile(name) {
        if (this._dnsPending)
            return;
        this._dnsPending = true;
        this._renderCurrent();
        this._call(
            'SetDnsProfile',
            new GLib.Variant('(s)', [name]),
            ([profile, state]) => {
                this._dnsProfile = profile;
                this._dnsState = state;
                this._dnsPending = false;
                this._showToast(profile
                    ? `Системный DNS: ${profile}`
                    : 'Системный DNS отключён');
                this._renderCurrent();
            },
            () => {
                this._dnsPending = false;
                this._renderCurrent();
            });
    }

    _confirmRemove(name) {
        if (this._pending.has(name))
            return;

        const dialog = new Adw.AlertDialog({
            heading: `Удалить профиль ${name}?`,
            body: 'Профиль будет остановлен, а его конфигурация удалена из системы.',
        });
        dialog.add_response('cancel', 'Отмена');
        dialog.add_response('remove', 'Удалить');
        dialog.set_response_appearance('remove', Adw.ResponseAppearance.DESTRUCTIVE);
        dialog.set_default_response('cancel');
        dialog.set_close_response('cancel');
        dialog.connect('response', (_dialog, response) => {
            if (response === 'remove')
                this._control('RemoveProfile', name);
        });
        dialog.present(this._window);
    }

    _chooseConfig() {
        const filter = new Gtk.FileFilter();
        filter.set_name('AmneziaWG configuration');
        filter.add_pattern('*.conf');
        const filters = Gio.ListStore.new(Gtk.FileFilter);
        filters.append(filter);
        const dialog = new Gtk.FileDialog({
            title: 'Импорт профиля',
            filters,
            default_filter: filter,
        });
        dialog.open(this._window, null, (source, result) => {
            try {
                const file = source.open_finish(result);
                this._promptProfileName(file);
            } catch (error) {
                if (!error.matches(Gtk.DialogError, Gtk.DialogError.DISMISSED))
                    this._showError(error);
            }
        });
    }

    _promptProfileName(file) {
        const basename = file.get_basename();
        const suggestedName = basename.toLowerCase().endsWith('.conf')
            ? basename.slice(0, -5)
            : basename;

        const entry = new Gtk.Entry({
            text: suggestedName,
            activates_default: true,
            hexpand: true,
        });
        const validation = new Gtk.Label({
            xalign: 0,
            wrap: true,
            visible: false,
        });
        validation.add_css_class('error');
        const content = new Gtk.Box({
            orientation: Gtk.Orientation.VERTICAL,
            spacing: 6,
        });
        content.append(entry);
        content.append(validation);

        const dialog = new Adw.AlertDialog({
            heading: 'Имя профиля',
            body: 'Имя используется в системе без преобразований.',
            extra_child: content,
        });
        dialog.add_response('cancel', 'Отмена');
        dialog.add_response('import', 'Импортировать');
        dialog.set_response_appearance('import', Adw.ResponseAppearance.SUGGESTED);
        dialog.set_default_response('import');
        dialog.set_close_response('cancel');

        const validate = () => {
            const name = entry.get_text();
            let message = '';
            if (!PROFILE_PATTERN.test(name)) {
                message = 'От 1 до 32 символов: латинские буквы, цифры и -; первый символ — буква или цифра.';
            } else if (this._profiles.has(name)) {
                message = `Профиль ${name} уже существует.`;
            }
            validation.set_label(message);
            validation.set_visible(message !== '');
            dialog.set_response_enabled('import', message === '');
        };
        entry.connect('changed', validate);
        dialog.connect('response', (_dialog, response) => {
            if (response === 'import')
                this._importFile(file, entry.get_text());
        });
        validate();
        dialog.present(this._window);
        entry.grab_focus();
        entry.select_region(0, -1);
    }

    _importFile(file, name) {
        const basename = file.get_basename();
        try {
            const [ok, contents] = file.load_contents(null);
            if (!ok)
                throw new Error(`Не удалось прочитать ${basename}`);
            const configuration = new TextDecoder().decode(contents);
            this._import(name, configuration);
        } catch (error) {
            this._showError(error);
        }
    }

    _import(name, configuration) {
        this._call('ImportProfile',
            new GLib.Variant('(ssb)', [name, configuration, false]),
            () => {
                this._showToast(`${name} импортирован`);
                this._refresh();
            });
    }

    _showToast(message) {
        this._toasts.add_toast(new Adw.Toast({title: message, timeout: 4}));
    }

    _showError(error) {
        if (error instanceof Gio.DBusError)
            Gio.DBusError.strip_remote_error(error);
        this._showToast(error.message);
    }
});

const application = new GateApplication();
application.run(ARGV);
