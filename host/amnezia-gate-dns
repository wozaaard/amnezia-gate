#!/usr/bin/bash
set -Eeuo pipefail

die() {
    printf 'amnezia-gate-dns: %s\n' "$*" >&2
    exit 1
}

profile_root=${AMNEZIA_PROFILE_ROOT:-/etc/amnezia/profiles}
global_config=${AMNEZIA_PROFILE_CONFIG:-/etc/amnezia/profiles.conf}
state_file=${AMNEZIA_DNS_STATE_FILE:-/etc/amnezia/dns-profile}
resolved_backend=${AMNEZIA_RESOLVED_BACKEND:-/usr/libexec/amnezia-gate-resolved}
netconfig_backend=${AMNEZIA_NETCONFIG_BACKEND:-/usr/libexec/amnezia-gate-netconfig}
ip_bin=${IP_BIN:-/usr/sbin/ip}
resolver_check_timeout=${AMNEZIA_DNS_RESOLVER_CHECK_TIMEOUT:-0.5}

DNS_BACKEND=auto
if [[ -r $global_config ]]; then
    # The global configuration is administrator-owned and already sourced by
    # the profile manager and runner.
    # shellcheck disable=SC1090
    source "$global_config"
fi
DNS_BACKEND=${AMNEZIA_DNS_BACKEND_MODE:-$DNS_BACKEND}

case $DNS_BACKEND in
    auto|resolved|netconfig|none) ;;
    *) die "DNS_BACKEND must be auto, resolved, netconfig or none: $DNS_BACKEND" ;;
esac

validate_profile() {
    [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,31}$ ]] ||
        die "invalid profile name: $1"
}

backend_path() {
    case $1 in
        resolved) printf '%s\n' "$resolved_backend" ;;
        netconfig) printf '%s\n' "$netconfig_backend" ;;
        *) die "invalid DNS backend: $1" ;;
    esac
}

backend_operational() {
    local path
    path=$(backend_path "$1")
    [[ -x $path ]] && "$path" check >/dev/null 2>&1
}

select_backend() {
    local name path
    local -a operational=()
    if [[ $DNS_BACKEND == none ]]; then
        die 'DNS integration is disabled by DNS_BACKEND=none'
    fi
    if [[ $DNS_BACKEND != auto ]]; then
        path=$(backend_path "$DNS_BACKEND")
        [[ -x $path ]] || die "DNS backend is not installed: $DNS_BACKEND"
        "$path" check || die "DNS backend is not operational: $DNS_BACKEND"
        printf '%s\n' "$DNS_BACKEND"
        return
    fi
    for name in resolved netconfig; do
        backend_operational "$name" && operational+=("$name")
    done
    case ${#operational[@]} in
        0) die 'no operational DNS backend; configure systemd-resolved or netconfig, or set DNS_BACKEND explicitly' ;;
        1) printf '%s\n' "${operational[0]}" ;;
        *) die 'multiple operational DNS backends; set DNS_BACKEND=resolved or DNS_BACKEND=netconfig' ;;
    esac
}

read_selection() {
    selection_backend=
    selection_profile=
    [[ -r $state_file ]] || return 0
    local first second
    IFS=$'\t' read -r first second <"$state_file" || true
    if [[ -n ${second:-} ]]; then
        selection_backend=$first
        selection_profile=$second
        case $selection_backend in
            resolved|netconfig) ;;
            *) die "invalid DNS backend in $state_file: $selection_backend" ;;
        esac
    else
        # Version 0.3 stored only the profile name. Resolve its owner using the
        # configured/operational backend and migrate it on the next write.
        selection_profile=${first:-}
    fi
    [[ -z $selection_profile ]] || validate_profile "$selection_profile"
}

selection_owner() {
    if [[ -n $selection_backend ]]; then
        printf '%s\n' "$selection_backend"
    else
        select_backend
    fi
}

write_selection() {
    local backend=$1 profile=$2 temporary
    install -d -m 0700 "${state_file%/*}" || return 1
    temporary=$(mktemp "${state_file}.XXXXXX") || return 1
    printf '%s\t%s\n' "$backend" "$profile" >"$temporary" || return 1
    chmod 0600 "$temporary" || return 1
    mv -f -- "$temporary" "$state_file" || return 1
}

profile_network() {
    local profile=$1 environment_file
    environment_file="$profile_root/$profile/profile.env"
    [[ -r $environment_file ]] || die "profile not found: $profile"
    NETWORK_PREFIX=
    NETWORK_SLOT=
    # profile.env is generated by amnezia-gate-profile and writable by root only.
    # shellcheck disable=SC1090
    source "$environment_file"
    [[ ${NETWORK_PREFIX:-} =~ ^([0-9]{1,3})\.([0-9]{1,3})$ ]] ||
        die "invalid NETWORK_PREFIX: ${NETWORK_PREFIX:-}"
    (( BASH_REMATCH[1] <= 255 && BASH_REMATCH[2] <= 255 )) ||
        die "invalid NETWORK_PREFIX: $NETWORK_PREFIX"
    [[ ${NETWORK_SLOT:-} =~ ^[0-9]+$ && $NETWORK_SLOT -lt 1024 ]] ||
        die "invalid NETWORK_SLOT: ${NETWORK_SLOT:-}"
    local third_octet=$((NETWORK_SLOT / 64))
    local fourth_octet=$(((NETWORK_SLOT % 64) * 4))
    dns_interface="az${NETWORK_SLOT}h"
    dns_address="${NETWORK_PREFIX}.${third_octet}.$((fourth_octet + 2))"
}

interface_exists() {
    "$ip_bin" link show dev "$1" >/dev/null 2>&1
}

resolver_ready() {
    [[ ${AMNEZIA_DNS_SKIP_RESOLVER_CHECK:-0} == 1 ]] && return 0
    /usr/bin/timeout "$resolver_check_timeout" /usr/bin/bash -c \
        "exec 3<>/dev/tcp/$dns_address/53" 2>/dev/null
}

apply_profile() {
    local backend=$1 profile=$2 path
    profile_network "$profile"
    interface_exists "$dns_interface" || return 2
    resolver_ready || return 3
    path=$(backend_path "$backend")
    [[ -x $path ]] || return 1
    "$path" apply "$dns_interface" "$dns_address"
}

revert_profile() {
    local backend=$1 profile=$2 path
    profile_network "$profile"
    path=$(backend_path "$backend")
    [[ -x $path ]] || return 0
    "$path" revert "$dns_interface" >/dev/null 2>&1 || true
}

use_profile() {
    local profile=${1:-} backend previous_backend previous_profile result=0
    validate_profile "$profile"
    profile_network "$profile"
    backend=$(select_backend)
    read_selection
    previous_profile=$selection_profile
    previous_backend=$selection_backend
    if [[ -n $previous_profile && -z $previous_backend ]]; then
        previous_backend=$(select_backend)
    fi

    if interface_exists "$dns_interface"; then
        apply_profile "$backend" "$profile" || result=$?
        if (( result == 3 )); then
            die "DNS resolver is unavailable for profile $profile; restart the profile after updating Amnezia Gate"
        fi
        (( result == 0 )) || die "failed to configure system DNS for profile: $profile"
    fi

    if ! write_selection "$backend" "$profile"; then
        revert_profile "$backend" "$profile"
        die "cannot store DNS profile selection: $profile"
    fi
    if [[ -n $previous_profile &&
          ( $previous_backend != "$backend" || $previous_profile != "$profile" ) ]]; then
        revert_profile "$previous_backend" "$previous_profile"
    fi
}

disable_dns() {
    local backend
    read_selection
    if [[ -n $selection_profile ]]; then
        backend=$(selection_owner)
        revert_profile "$backend" "$selection_profile"
    fi
    rm -f -- "$state_file"
}

sync_profile() {
    local profile=${1:-} backend result=0
    validate_profile "$profile"
    read_selection
    [[ $selection_profile == "$profile" ]] || return 0
    backend=$(selection_owner)
    apply_profile "$backend" "$profile" || result=$?
    (( result == 0 )) || die "failed to restore system DNS for profile: $profile"
    [[ -n $selection_backend ]] || write_selection "$backend" "$profile"
}

restore_selection() {
    local backend result=0
    read_selection
    [[ -n $selection_profile ]] || return 0
    backend=$(selection_owner)
    profile_network "$selection_profile"
    interface_exists "$dns_interface" || return 0
    apply_profile "$backend" "$selection_profile" || result=$?
    (( result == 0 )) || die "failed to restore system DNS for profile: $selection_profile"
    [[ -n $selection_backend ]] || write_selection "$backend" "$selection_profile"
}

restore_backend() {
    local requested=${1:-} owner
    case $requested in resolved|netconfig) ;; *) die 'restore-backend requires resolved or netconfig' ;; esac
    read_selection
    [[ -n $selection_profile ]] || return 0
    owner=$(selection_owner)
    [[ $owner == "$requested" ]] || return 0
    restore_selection
}

unsync_profile() {
    local profile=${1:-} backend
    validate_profile "$profile"
    read_selection
    [[ $selection_profile == "$profile" ]] || return 0
    backend=$(selection_owner)
    revert_profile "$backend" "$profile"
}

forget_profile() {
    local profile=${1:-} backend
    validate_profile "$profile"
    read_selection
    [[ $selection_profile == "$profile" ]] || return 0
    backend=$(selection_owner)
    revert_profile "$backend" "$profile"
    rm -f -- "$state_file"
}

show_status() {
    local backend path
    read_selection
    if [[ -z $selection_profile ]]; then
        printf '%s\t%s\n' '-' off
        return
    fi
    backend=$(selection_owner)
    profile_network "$selection_profile"
    if ! interface_exists "$dns_interface"; then
        printf '%s\t%s\n' "$selection_profile" waiting
        return
    fi
    if ! resolver_ready; then
        printf '%s\t%s\n' "$selection_profile" unavailable
        return
    fi
    path=$(backend_path "$backend")
    if [[ -x $path ]] && "$path" check >/dev/null 2>&1 &&
       "$path" active "$dns_interface" "$dns_address" >/dev/null 2>&1; then
        printf '%s\t%s\n' "$selection_profile" active
    else
        printf '%s\t%s\n' "$selection_profile" unavailable
    fi
}

show_mode() {
    local backend path
    backend=$(select_backend)
    path=$(backend_path "$backend")
    "$path" mode
}

remove_backend() {
    local backend=${1:-} owner
    case $backend in resolved|netconfig) ;; *) die 'remove-backend requires resolved or netconfig' ;; esac
    read_selection
    if [[ -z $selection_backend && -n $selection_profile ]]; then
        owner=$(selection_owner)
        [[ $owner == "$backend" ]] || return 0
    else
        [[ $selection_backend == "$backend" ]] || return 0
    fi
    (revert_profile "$backend" "$selection_profile") || true
    rm -f -- "$state_file"
}

command=${1:-}
shift || true
case $command in
    backend)
        [[ $# -eq 0 ]] || die 'backend does not accept arguments'
        (select_backend) 2>/dev/null || true
        ;;
    mode) [[ $# -eq 0 ]] || die 'mode does not accept arguments'; show_mode ;;
    check)
        [[ $# -eq 0 ]] || die 'check does not accept arguments'
        select_backend >/dev/null
        ;;
    use) use_profile "$@" ;;
    off) [[ $# -eq 0 ]] || die 'off does not accept arguments'; disable_dns ;;
    status) [[ $# -eq 0 ]] || die 'status does not accept arguments'; show_status ;;
    restore) [[ $# -eq 0 ]] || die 'restore does not accept arguments'; restore_selection ;;
    restore-backend) restore_backend "$@" ;;
    sync) sync_profile "$@" ;;
    unsync) unsync_profile "$@" ;;
    forget) forget_profile "$@" ;;
    remove-backend) remove_backend "$@" ;;
    *) die 'usage: amnezia-gate-dns backend|mode|check|use PROFILE|off|status|restore|restore-backend BACKEND|sync PROFILE|unsync PROFILE|forget PROFILE' ;;
esac
