#!/usr/bin/bash
set -Eeuo pipefail

die() {
    printf 'amnezia-gate-run: %s\n' "$*" >&2
    exit 1
}

action=${1:-}
profile=${2:-}
[[ $action == prepare || $action == run || $action == cleanup ]] ||
    die 'usage: amnezia-gate-run prepare|run|cleanup PROFILE'
[[ $profile =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$ ]] || die "invalid profile name: $profile"

ip_bin=${IP_BIN:-/usr/sbin/ip}
nft_bin=${NFT_BIN:-/usr/sbin/nft}
iptables_bin=${IPTABLES_BIN:-/usr/sbin/iptables}
nspawn_bin=${NSPAWN_BIN:-/usr/bin/systemd-nspawn}
nspawn_register=${NSPAWN_REGISTER:-yes}

profile_root=${AMNEZIA_PROFILE_ROOT:-/etc/amnezia/profiles}
profile_dir="$profile_root/$profile"
environment_file="$profile_dir/profile.env"
awg_config="$profile_dir/awg0.conf"
resolv_config="$profile_dir/resolv.conf"
device_root=${AMNEZIA_PROFILE_DEVICE_ROOT:-/dev/amnezia-gate}
tun_device="$device_root/${profile}-tun"

[[ -r "$environment_file" ]] || die "$environment_file is not readable"
# profile.env is generated by amnezia-gate-profile and writable by root only.
# shellcheck disable=SC1090
source "$environment_file"
FORWARD_COMPAT=${FORWARD_COMPAT:-auto}

required=(
    ROOTFS_IMAGE NETWORK_PREFIX NETWORK_SLOT LISTEN_ADDRESS LAN_CIDRS
    SOCKS_PORT HTTP_PORT DNS_SERVERS
)
for name in "${required[@]}"; do
    [[ -n ${!name:-} ]] || die "$name is missing in $environment_file"
done

[[ $NETWORK_PREFIX =~ ^([0-9]{1,3})\.([0-9]{1,3})$ ]] ||
    die "invalid NETWORK_PREFIX: $NETWORK_PREFIX"
(( BASH_REMATCH[1] <= 255 && BASH_REMATCH[2] <= 255 )) ||
    die "invalid NETWORK_PREFIX: $NETWORK_PREFIX"
[[ $NETWORK_SLOT =~ ^[0-9]+$ && $NETWORK_SLOT -lt 1024 ]] ||
    die "invalid NETWORK_SLOT: $NETWORK_SLOT"
[[ $SOCKS_PORT =~ ^[0-9]+$ && $SOCKS_PORT -ge 1024 && $SOCKS_PORT -le 65535 ]] ||
    die "invalid SOCKS_PORT: $SOCKS_PORT"
[[ $HTTP_PORT =~ ^[0-9]+$ && $HTTP_PORT -ge 1024 && $HTTP_PORT -le 65535 ]] ||
    die "invalid HTTP_PORT: $HTTP_PORT"
[[ $LISTEN_ADDRESS == 0.0.0.0 || $LISTEN_ADDRESS =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] ||
    die "invalid LISTEN_ADDRESS: $LISTEN_ADDRESS"
case $FORWARD_COMPAT in
    auto|none|iptables) ;;
    *) die "FORWARD_COMPAT must be auto, none or iptables: $FORWARD_COMPAT" ;;
esac

third_octet=$((NETWORK_SLOT / 64))
fourth_octet=$(((NETWORK_SLOT % 64) * 4))
network_cidr="${NETWORK_PREFIX}.${third_octet}.${fourth_octet}/30"
host_address="${NETWORK_PREFIX}.${third_octet}.$((fourth_octet + 1))"
guest_address="${NETWORK_PREFIX}.${third_octet}.$((fourth_octet + 2))"
host_interface="az${NETWORK_SLOT}h"
guest_interface="az${NETWORK_SLOT}c"
nft_table="amnezia_gate_${NETWORK_SLOT}"
machine="amnezia-${profile}"
interface_alias="amnezia-gate:${profile}"
selinux_level="s0:c${NETWORK_SLOT}"

allowed_source_cidrs=("$network_cidr")
allowed_sources=$network_cidr
IFS=', ' read -r -a configured_lans <<<"$LAN_CIDRS"
for cidr in "${configured_lans[@]}"; do
    [[ -n $cidr ]] || continue
    [[ $cidr =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] ||
        die "unsupported LAN CIDR: $cidr"
    allowed_source_cidrs+=("$cidr")
    allowed_sources+=", $cidr"
done

add_forward_rule() {
    if ! "$iptables_bin" -w -C FORWARD "$@" >/dev/null 2>&1; then
        "$iptables_bin" -w -I FORWARD 1 "$@"
    fi
}

delete_forward_rule() {
    if "$iptables_bin" -w -C FORWARD "$@" >/dev/null 2>&1; then
        "$iptables_bin" -w -D FORWARD "$@"
    fi
}

forward_rules() {
    local operation=$1 cidr

    "$operation" \
        -i "$host_interface" \
        -m comment --comment "$interface_alias" \
        -j ACCEPT
    "$operation" \
        -o "$host_interface" \
        -m conntrack --ctstate ESTABLISHED,RELATED \
        -m comment --comment "$interface_alias" \
        -j ACCEPT
    for cidr in "${allowed_source_cidrs[@]}"; do
        "$operation" \
            -o "$host_interface" \
            -s "$cidr" -d "$guest_address" \
            -p tcp -m multiport --dports 1080,10080 \
            -m comment --comment "$interface_alias" \
            -j ACCEPT
    done
}

cleanup_forward_rules() {
    [[ -x $iptables_bin ]] || return 0
    "$iptables_bin" -w -S FORWARD >/dev/null 2>&1 || return 0
    forward_rules delete_forward_rule
}

install_forward_rules() {
    local rules
    case $FORWARD_COMPAT in
        none)
            return 0
            ;;
        auto)
            [[ -x $iptables_bin ]] || return 0
            if ! rules=$("$iptables_bin" -w -S FORWARD 2>/dev/null); then
                die 'cannot inspect iptables FORWARD; set FORWARD_COMPAT=none to use nftables only'
            fi
            [[ $rules != '-P FORWARD ACCEPT' ]] || return 0
            ;;
        iptables)
            [[ -x $iptables_bin ]] || die "iptables is required by FORWARD_COMPAT=iptables: $iptables_bin"
            "$iptables_bin" -w -S FORWARD >/dev/null 2>&1 ||
                die 'cannot inspect iptables FORWARD'
            ;;
    esac
    forward_rules add_forward_rule
}

interface_owned() {
    local interface=$1 alias_file="/sys/class/net/${interface}/ifalias"
    [[ -r $alias_file && $(<"$alias_file") == "$interface_alias" ]]
}

delete_interface() {
    local interface=$1
    [[ -e /sys/class/net/$interface ]] || return 0
    interface_owned "$interface" || die "network interface collision: $interface"
    "$ip_bin" link delete dev "$interface"
}

delete_nft_table() {
    if "$nft_bin" list table ip "$nft_table" >/dev/null 2>&1; then
        "$nft_bin" delete table ip "$nft_table"
    fi
}

cleanup_network() {
    cleanup_forward_rules
    delete_nft_table
    delete_interface "$host_interface"
    delete_interface "$guest_interface"
    if [[ -e $tun_device || -L $tun_device ]]; then
        /usr/bin/rm -f -- "$tun_device"
    fi
    /usr/bin/rmdir --ignore-fail-on-non-empty "$device_root" 2>/dev/null || true
}

wait_nspawn_cleanup() {
    local attempt runtime_path="/run/systemd/nspawn/$machine/unix-export"
    for ((attempt = 0; attempt < 50; attempt++)); do
        [[ ! -e $runtime_path ]] && return 0
        sleep 0.1
    done
    die "nspawn export directory was not removed: $runtime_path"
}

prepare_network() {
    local dns resolv_tmp
    local -a dns_servers

    [[ -f $ROOTFS_IMAGE && -r $ROOTFS_IMAGE ]] ||
        die "nspawn rootfs image not found: $ROOTFS_IMAGE"
    [[ -r $awg_config ]] || die "$awg_config is not readable"
    IFS=',' read -r -a dns_servers <<<"$DNS_SERVERS"
    (( ${#dns_servers[@]} > 0 )) || die 'DNS_SERVERS is empty'
    for dns in "${dns_servers[@]}"; do
        [[ $dns =~ ^[0-9a-fA-F:.]+$ ]] || die "invalid DNS server: $dns"
    done

    resolv_tmp=$(mktemp "$profile_dir/.resolv.conf.XXXXXX")
    chmod 0644 "$resolv_tmp"
    for dns in "${dns_servers[@]}"; do
        printf 'nameserver %s\n' "$dns" >>"$resolv_tmp"
    done
    mv -f -- "$resolv_tmp" "$resolv_config"

    "$nspawn_bin" --cleanup --machine="$machine" \
        --image="$ROOTFS_IMAGE" >/dev/null 2>&1 || true
    if [[ ${AMNEZIA_PROFILE_TESTING:-0} != 1 ]]; then
        wait_nspawn_cleanup
    fi
    cleanup_network

    if [[ ${AMNEZIA_PROFILE_TESTING:-0} == 1 ]]; then
        /usr/bin/install -d -m 0700 "$device_root"
    else
        /usr/bin/install -d -o root -g root -m 0700 "$device_root"
    fi
    if [[ -e $tun_device || -L $tun_device ]]; then
        /usr/bin/rm -f -- "$tun_device"
    fi

    if [[ ${AMNEZIA_PROFILE_TESTING:-0} != 1 ]]; then
        [[ -c /dev/net/tun ]] || die '/dev/net/tun is unavailable'
        /usr/bin/mknod -m 0600 "$tun_device" c 10 200
        if [[ -e /sys/fs/selinux/enforce ]]; then
            /usr/bin/chcon -u system_u -r object_r -t container_file_t \
                -l "$selinux_level" "$awg_config" "$resolv_config" "$tun_device"
        fi
    else
        : >"$tun_device"
        chmod 0600 "$tun_device"
    fi

    "$ip_bin" link add name "$host_interface" type veth peer name "$guest_interface"
    "$ip_bin" link set dev "$host_interface" alias "$interface_alias"
    "$ip_bin" link set dev "$guest_interface" alias "$interface_alias"
    "$ip_bin" address add "$host_address/30" dev "$host_interface"
    "$ip_bin" link set dev "$host_interface" up
    if [[ ${AMNEZIA_PROFILE_TESTING:-0} != 1 ]]; then
        printf '1\n' >"/proc/sys/net/ipv4/conf/$host_interface/route_localnet"
        /usr/bin/udevadm wait --timeout=5 --initialized=yes --settle \
            "/sys/class/net/$guest_interface"
    fi

    local destination_match
    if [[ $LISTEN_ADDRESS == 0.0.0.0 ]]; then
        destination_match='fib daddr type local'
    else
        destination_match="ip daddr $LISTEN_ADDRESS"
    fi

    "$nft_bin" -f - <<EOF
table ip $nft_table {
    set allowed_sources {
        type ipv4_addr
        flags interval
        elements = { $allowed_sources }
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        ip saddr @allowed_sources $destination_match tcp dport $SOCKS_PORT counter dnat to $guest_address:1080
        ip saddr @allowed_sources $destination_match tcp dport $HTTP_PORT counter dnat to $guest_address:10080
    }

    chain output {
        type nat hook output priority dstnat; policy accept;
        $destination_match tcp dport $SOCKS_PORT counter dnat to $guest_address:1080
        $destination_match tcp dport $HTTP_PORT counter dnat to $guest_address:10080
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        fib saddr type local ip daddr $guest_address tcp dport { 1080, 10080 } counter snat to $host_address
        ip saddr $guest_address oifname != "$host_interface" counter masquerade
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname "$host_interface" counter accept
        oifname "$host_interface" ct state established,related counter accept
        oifname "$host_interface" ip saddr @allowed_sources ip daddr $guest_address tcp dport { 1080, 10080 } counter accept
        oifname "$host_interface" counter drop
    }
}
EOF

    install_forward_rules
}

run_container() {
    local drop_capabilities
    local -a selinux_args=()
    drop_capabilities=$(
        IFS=,
        printf '%s' "${drop_capability_list[*]}"
    )
    if [[ -e /sys/fs/selinux/enforce ]]; then
        selinux_args=(
            "--selinux-context=system_u:system_r:container_t:$selinux_level"
            "--selinux-apifs-context=system_u:object_r:container_file_t:$selinux_level"
        )
    fi
    exec "$nspawn_bin" \
        --quiet \
        --keep-unit \
        --register="$nspawn_register" \
        --machine="$machine" \
        --image="$ROOTFS_IMAGE" \
        --volatile=overlay \
        --as-pid2 \
        --console=pipe \
        --kill-signal=SIGRTMIN+3 \
        --restrict-address-families="AF_UNIX AF_INET AF_INET6 AF_NETLINK" \
        "${selinux_args[@]}" \
        --resolv-conf=off \
        --network-interface="$guest_interface:host0" \
        --bind="$tun_device:/dev/net/tun" \
        --bind-ro="$awg_config:/config/awg0.conf" \
        --bind-ro="$resolv_config:/etc/resolv.conf" \
        --setenv="PROFILE_NAME=$profile" \
        --setenv="LAN_CIDRS=$LAN_CIDRS" \
        --setenv="OUTER_ADDRESS=$guest_address/30" \
        --setenv="OUTER_GATEWAY=$host_address" \
        --no-new-privileges=yes \
        --capability=CAP_NET_ADMIN \
        --drop-capability="$drop_capabilities" \
        /usr/local/sbin/amnezia-gate-entrypoint
}

drop_capability_list=(
    CAP_AUDIT_CONTROL CAP_AUDIT_WRITE CAP_CHOWN CAP_DAC_OVERRIDE
    CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_IPC_OWNER CAP_LEASE
    CAP_LINUX_IMMUTABLE CAP_MKNOD CAP_NET_BIND_SERVICE CAP_NET_BROADCAST
    CAP_SETFCAP CAP_SETPCAP CAP_SYS_ADMIN CAP_SYS_BOOT CAP_SYS_CHROOT
    CAP_SYS_NICE CAP_SYS_PTRACE CAP_SYS_RESOURCE CAP_SYS_TTY_CONFIG
)

case "$action" in
    prepare)
        prepare_network
        ;;
    run)
        run_container
        ;;
    cleanup)
        "$nspawn_bin" --cleanup --machine="$machine" \
            --image="$ROOTFS_IMAGE" >/dev/null 2>&1 || true
        cleanup_network
        ;;
esac
