#!/usr/bin/bash
set -Eeuo pipefail

state_dir=/run/amnezia-gate
state_file=$state_dir/ip-forward.original
forward_file=/proc/sys/net/ipv4/ip_forward

case ${1:-} in
    up)
        mkdir -p -m 0755 "$state_dir"
        if [[ ! -e $state_file ]]; then
            read -r original <"$forward_file"
            printf '%s\n' "$original" >"$state_file"
            chmod 0600 "$state_file"
        fi
        printf '1\n' >"$forward_file"
        ;;
    down)
        if [[ -r $state_file ]]; then
            read -r original <"$state_file"
            [[ $original == 0 || $original == 1 ]] || exit 1
            printf '%s\n' "$original" >"$forward_file"
            rm -f -- "$state_file"
        fi
        ;;
    *)
        printf 'usage: amnezia-gate-network up|down\n' >&2
        exit 1
        ;;
esac
