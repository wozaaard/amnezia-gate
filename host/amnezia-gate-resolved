#!/usr/bin/bash
set -Eeuo pipefail

die() {
    printf 'amnezia-gate-resolved: %s\n' "$*" >&2
    exit 1
}

profile_root=${AMNEZIA_PROFILE_ROOT:-/etc/amnezia/profiles}
state_file=${AMNEZIA_DNS_STATE_FILE:-/etc/amnezia/dns-profile}
resolv_conf=${AMNEZIA_RESOLV_CONF:-/etc/resolv.conf}
resolvectl_bin=${RESOLVECTL_BIN:-/usr/bin/resolvectl}
ip_bin=${IP_BIN:-/usr/sbin/ip}
resolver_check_timeout=${AMNEZIA_DNS_RESOLVER_CHECK_TIMEOUT:-0.5}

validate_profile() {
    [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,31}$ ]] ||
        die "invalid profile name: $1"
}

selected_profile() {
    [[ -r $state_file ]] || return 0
    local selected
    read -r selected <"$state_file" || true
    [[ -z $selected ]] || validate_profile "$selected"
    printf '%s' "$selected"
}

profile_network() {
    local profile=$1 environment_file
    environment_file="$profile_root/$profile/profile.env"
    [[ -r $environment_file ]] || die "profile not found: $profile"
    NETWORK_PREFIX=
    NETWORK_SLOT=
    # profile.env is generated by amnezia-gate-profile and writable by root only.
    # shellcheck disable=SC1090
    source "$environment_file"
    [[ ${NETWORK_PREFIX:-} =~ ^([0-9]{1,3})\.([0-9]{1,3})$ ]] ||
        die "invalid NETWORK_PREFIX: ${NETWORK_PREFIX:-}"
    (( BASH_REMATCH[1] <= 255 && BASH_REMATCH[2] <= 255 )) ||
        die "invalid NETWORK_PREFIX: $NETWORK_PREFIX"
    [[ ${NETWORK_SLOT:-} =~ ^[0-9]+$ && $NETWORK_SLOT -lt 1024 ]] ||
        die "invalid NETWORK_SLOT: ${NETWORK_SLOT:-}"
    local third_octet=$((NETWORK_SLOT / 64))
    local fourth_octet=$(((NETWORK_SLOT % 64) * 4))
    dns_interface="az${NETWORK_SLOT}h"
    dns_address="${NETWORK_PREFIX}.${third_octet}.$((fourth_octet + 2))"
}

interface_exists() {
    "$ip_bin" link show dev "$1" >/dev/null 2>&1
}

resolver_ready() {
    [[ ${AMNEZIA_DNS_SKIP_RESOLVER_CHECK:-0} == 1 ]] && return 0
    /usr/bin/timeout "$resolver_check_timeout" /usr/bin/bash -c \
        "exec 3<>/dev/tcp/$dns_address/53" 2>/dev/null
}

check_resolved() {
    if [[ ! -x $resolvectl_bin ]]; then
        printf 'amnezia-gate-resolved: systemd-resolved client is unavailable: %s; install the systemd-resolved package\n' \
            "$resolvectl_bin" >&2
        return 1
    fi
    if ! "$resolvectl_bin" status >/dev/null 2>&1; then
        printf 'amnezia-gate-resolved: systemd-resolved is unavailable\n' >&2
        return 1
    fi
    if [[ ${AMNEZIA_DNS_SKIP_SYSTEM_CHECK:-0} != 1 ]]; then
        if [[ ! -r $resolv_conf ]]; then
            printf 'amnezia-gate-resolved: %s is not readable\n' "$resolv_conf" >&2
            return 1
        fi
        if ! grep -Eq '^[[:space:]]*nameserver[[:space:]]+127\.0\.0\.53([[:space:]]|$)' \
            "$resolv_conf"; then
            printf '%s\n' \
                'amnezia-gate-resolved: system resolver does not use the systemd-resolved stub at 127.0.0.53' >&2
            return 1
        fi
    fi
}

apply_profile() {
    local profile=$1
    profile_network "$profile"
    interface_exists "$dns_interface" || return 2
    resolver_ready || return 3
    check_resolved || return 1

    # Configure routing before publishing the DNS server. This avoids a window
    # where resolved can use the server as an ordinary default-route link.
    "$resolvectl_bin" domain "$dns_interface" '~.' || return 1
    "$resolvectl_bin" default-route "$dns_interface" no || return 1
    "$resolvectl_bin" llmnr "$dns_interface" no || return 1
    "$resolvectl_bin" mdns "$dns_interface" no || return 1
    "$resolvectl_bin" dnsovertls "$dns_interface" no || return 1
    "$resolvectl_bin" dnssec "$dns_interface" no || return 1
    "$resolvectl_bin" dns "$dns_interface" "$dns_address" || return 1
}

revert_profile() {
    local profile=$1
    profile_network "$profile"
    interface_exists "$dns_interface" || return 0
    [[ -x $resolvectl_bin ]] || return 0
    "$resolvectl_bin" revert "$dns_interface" >/dev/null 2>&1 || true
}

write_selection() {
    local profile=$1 temporary
    install -d -m 0700 "${state_file%/*}" || return 1
    temporary=$(mktemp "${state_file}.XXXXXX") || return 1
    printf '%s\n' "$profile" >"$temporary" || return 1
    chmod 0600 "$temporary" || return 1
    mv -f -- "$temporary" "$state_file" || return 1
}

use_profile() {
    local profile=${1:-} previous result=0
    validate_profile "$profile"
    profile_network "$profile"
    check_resolved || die 'systemd-resolved integration is not ready'
    previous=$(selected_profile)

    if interface_exists "$dns_interface"; then
        apply_profile "$profile" || result=$?
        if (( result == 3 )); then
            die "DNS resolver is unavailable for profile $profile; restart the profile after updating Amnezia Gate"
        fi
        (( result == 0 )) || die "failed to configure system DNS for profile: $profile"
    fi

    if ! write_selection "$profile"; then
        revert_profile "$profile"
        die "cannot store DNS profile selection: $profile"
    fi
    if [[ -n $previous && $previous != "$profile" ]]; then
        revert_profile "$previous"
    fi
}

disable_dns() {
    local selected
    selected=$(selected_profile)
    [[ -z $selected ]] || revert_profile "$selected"
    rm -f -- "$state_file"
}

sync_profile() {
    local profile=${1:-} selected result=0
    validate_profile "$profile"
    selected=$(selected_profile)
    [[ $selected == "$profile" ]] || return 0
    apply_profile "$profile" || result=$?
    (( result == 0 )) || die "failed to restore system DNS for profile: $profile"
}

restore_selection() {
    local selected result=0
    selected=$(selected_profile)
    [[ -n $selected ]] || return 0
    profile_network "$selected"
    interface_exists "$dns_interface" || return 0
    apply_profile "$selected" || result=$?
    (( result == 0 )) || die "failed to restore system DNS for profile: $selected"
}

unsync_profile() {
    local profile=${1:-} selected
    validate_profile "$profile"
    selected=$(selected_profile)
    [[ $selected == "$profile" ]] || return 0
    revert_profile "$profile"
}

forget_profile() {
    local profile=${1:-} selected
    validate_profile "$profile"
    selected=$(selected_profile)
    [[ $selected == "$profile" ]] || return 0
    revert_profile "$profile"
    rm -f -- "$state_file"
}

show_status() {
    local selected result=0
    selected=$(selected_profile)
    if [[ -z $selected ]]; then
        printf '%s\t%s\n' '-' off
        return
    fi
    profile_network "$selected"
    if ! interface_exists "$dns_interface"; then
        printf '%s\t%s\n' "$selected" waiting
        return
    fi
    if ! resolver_ready; then
        printf '%s\t%s\n' "$selected" unavailable
        return
    fi
    check_resolved || result=$?
    if (( result == 0 )); then
        printf '%s\t%s\n' "$selected" active
    else
        printf '%s\t%s\n' "$selected" unavailable
    fi
}

command=${1:-}
shift || true
case $command in
    use) use_profile "$@" ;;
    off) [[ $# -eq 0 ]] || die 'off does not accept arguments'; disable_dns ;;
    status) [[ $# -eq 0 ]] || die 'status does not accept arguments'; show_status ;;
    check) [[ $# -eq 0 ]] || die 'check does not accept arguments'; check_resolved ;;
    restore) [[ $# -eq 0 ]] || die 'restore does not accept arguments'; restore_selection ;;
    sync) sync_profile "$@" ;;
    unsync) unsync_profile "$@" ;;
    forget) forget_profile "$@" ;;
    *) die 'usage: amnezia-gate-resolved use PROFILE|off|status|check|restore|sync PROFILE|unsync PROFILE|forget PROFILE' ;;
esac
