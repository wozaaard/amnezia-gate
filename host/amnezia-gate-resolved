#!/usr/bin/bash
set -Eeuo pipefail

die() {
    printf 'amnezia-gate-resolved: %s\n' "$*" >&2
    exit 1
}

resolv_conf=${AMNEZIA_RESOLV_CONF:-/etc/resolv.conf}
resolvectl_bin=${RESOLVECTL_BIN:-/usr/bin/resolvectl}

check_resolved() {
    [[ -x $resolvectl_bin ]] || die "systemd-resolved client is unavailable: $resolvectl_bin"
    "$resolvectl_bin" status >/dev/null 2>&1 || die 'systemd-resolved is unavailable'
    if [[ ${AMNEZIA_DNS_SKIP_SYSTEM_CHECK:-0} != 1 ]]; then
        [[ -r $resolv_conf ]] || die "$resolv_conf is not readable"
        grep -Eq '^[[:space:]]*nameserver[[:space:]]+127\.0\.0\.53([[:space:]]|$)' \
            "$resolv_conf" ||
            die 'system resolver does not use the systemd-resolved stub at 127.0.0.53'
    fi
}

validate_arguments() {
    [[ ${1:-} =~ ^az[0-9]+h$ ]] || die "invalid DNS interface: ${1:-}"
    [[ ${2:-} =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] ||
        die "invalid DNS address: ${2:-}"
}

apply_dns() {
    local interface=${1:-} address=${2:-}
    validate_arguments "$interface" "$address"
    check_resolved
    "$resolvectl_bin" domain "$interface" '~.'
    "$resolvectl_bin" default-route "$interface" no
    "$resolvectl_bin" llmnr "$interface" no
    "$resolvectl_bin" mdns "$interface" no
    "$resolvectl_bin" dnsovertls "$interface" no
    "$resolvectl_bin" dnssec "$interface" no
    "$resolvectl_bin" dns "$interface" "$address"
}

revert_dns() {
    local interface=${1:-}
    [[ $interface =~ ^az[0-9]+h$ ]] || die "invalid DNS interface: $interface"
    [[ -x $resolvectl_bin ]] || return 0
    "$resolvectl_bin" revert "$interface" >/dev/null 2>&1 || true
}

command=${1:-}
shift || true
case $command in
    check) [[ $# -eq 0 ]] || die 'check does not accept arguments'; check_resolved ;;
    mode) [[ $# -eq 0 ]] || die 'mode does not accept arguments'; check_resolved; printf '%s\n' resolved ;;
    apply) [[ $# -eq 2 ]] || die 'apply requires INTERFACE ADDRESS'; apply_dns "$@" ;;
    revert) [[ $# -eq 1 ]] || die 'revert requires INTERFACE'; revert_dns "$@" ;;
    active)
        [[ $# -eq 2 ]] || die 'active requires INTERFACE ADDRESS'
        validate_arguments "$@"
        check_resolved
        ;;
    *) die 'usage: amnezia-gate-resolved check|mode|apply INTERFACE ADDRESS|revert INTERFACE|active INTERFACE ADDRESS' ;;
esac
